VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# External-provider credentials belong in Supabase Edge Function secrets, never VITE_* variables.
# Open-Meteo currently needs no API key. Add provider secrets only when connecting a verified source.